# Set default recipe to list all commands
default: list

# List all available recipes
list:
    @just --list

# Run the simulation
run:
    uv run -m permanence_env

# Run all quality checks (formatting + linting + type checking + tests)
check: format-check lint typecheck test

# Run all tests
test:
    uv run pytest tests/

# Run tests and generate coverage report (excluding UI)
coverage:
    uv run pytest tests/ --cov=permanence_env --cov-report=term-missing --cov-config=.coveragerc

# Format the source code with ruff
format:
    uvx ruff format src/

# Check formatting without making changes
format-check:
    uvx ruff format src/ --check

# Lint the source code with ruff
lint:
    uvx ruff check src/

# Auto-fix linting issues where possible
fix:
    uvx ruff check src/ --fix

# Type check the source code with ty
typecheck:
    uvx ty check src/

# Synchronize project dependencies
sync:
    uv sync

# Clean up __pycache__, build artifacts, and tool caches
clean:
    uvx pyclean . -d all
