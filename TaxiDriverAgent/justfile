APP_NAME := "taxi_driver_agent"

# Default recipe to display help
default:
    @just --list

# Install dependencies
install:
    uv sync

# Install development dependencies
install-dev:
    uv sync --dev

# Update all dependencies
update:
    uv sync --upgrade

# Run the application
run *args:
    uv run src/{{APP_NAME}} {{args}}

# Run the tutorial in training mode
run-training:
    uv run src/{{APP_NAME}} --mode=training --model-file=agent.model --duration=120

# Run the tutorial in training mode
run-validation:
    uv run src/{{APP_NAME}} --mode=validation --model-file=agent.model --duration=120

# Run tests
test:
    uvx pytest

# Run tests with coverage
test-cov:
    uvx pytest --cov=src --cov-report=html --cov-report=term

# Run profiling
profile:
    uv run python -m cProfile -o {{APP_NAME}}.prof -m {{APP_NAME}}
    uvx snakeviz {{APP_NAME}}.prof

# Run linting
lint:
    uvx ruff check .
    uvx ty check .

# Format code
format:
    uvx ruff format .
    uvx ruff check --fix .

# Run security checks
security:
    uvx bandit -r src/

# Clean build artifacts and cache
clean:
    uvx pyclean .

# Build the package
build:
    uv build

# Install the package in development mode
dev-install:
    uv pip install -e .

# Run pre-commit hooks
pre-commit:
    uvx pre-commit run --all-files

# Initialize pre-commit
init-pre-commit:
    uvx pre-commit install

# Enter the virtual environment shell
shell:
    uv run python

# Show project info
info:
    uv version
    @echo ""
    @echo "Python version:"
    uv run python --version

# Export requirements.txt for compatibility
export-requirements:
    uv export --format requirements-txt --output-file requirements.txt

# Lock dependencies
lock:
    uv lock

# Start editing
edit:
    uv run nvim
